<?xml version="1.0" encoding="UTF-8"?>
<!--
  PLACEHOLDER — not a real Firebase config. Copy this file to
  "GoogleService-Info.plist" (gitignored) and replace every value with your own
  Firebase iOS app config, downloaded from the Firebase console. In CI, inject the
  real file per lane instead of committing it. See doc/FirebaseRemoteConfig.md.
  Firebase is opt-in: set FIREBASE_ENABLED=true so app.config.ts wires this file.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>API_KEY</key>
	<string>REPLACE_WITH_YOUR_IOS_FIREBASE_API_KEY</string>
	<key>GCM_SENDER_ID</key>
	<string>000000000000</string>
	<key>BUNDLE_ID</key>
	<string>com.nventive.internal.reactnativeapptemplate</string>
	<key>PROJECT_ID</key>
	<string>your-firebase-project-id</string>
	<key>STORAGE_BUCKET</key>
	<string>your-firebase-project-id.appspot.com</string>
	<key>IS_ADS_ENABLED</key>
	<false/>
	<key>IS_ANALYTICS_ENABLED</key>
	<false/>
	<key>IS_APPINVITE_ENABLED</key>
	<true/>
	<key>IS_GCM_ENABLED</key>
	<true/>
	<key>IS_SIGNIN_ENABLED</key>
	<true/>
	<key>GOOGLE_APP_ID</key>
	<string>1:000000000000:ios:0000000000000000000000</string>
</dict>
</plist>
